# Copy to .env (never committed) — mirrors GitHub Secret DISCORD_WEBHOOK_URL
# .env is read at runtime in editor/builds via _get_webhook_url()
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0000000000000000000/PLACEHOLDER_TOKEN_DO_NOT_USE
# also supported: discord/webhook_url (same value)
# discord/webhook_url=https://discord.com/api/webhooks/...
